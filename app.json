{
  "expo": {
    "name": "Doctor Contact",
    "slug": "doctor-contact",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-icon.png",
    "scheme": "doctorcontact",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doctorcontact.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Doctor Contact needs access to your microphone for voice searching doctors, clinics, and medical specialties.",
        "NSLocationWhenInUseUsageDescription": "Doctor Contact needs access to your location to find nearby clinics, diagnostic labs, and available doctors."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-icon.png",
        "backgroundColor": "#1B3A8C"
      },
      "package": "com.doctorcontact.app",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B3A8C",
          "image": "./assets/logo-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a73a188-7286-4fb8-985b-0d92bef5889e"
      }
    },
    "owner": "ampl"
  }
}
